{
  "name": "nexus-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "env:generate": "node scripts/generate-runtime-env.js",
    "env:validate": "node scripts/validate-production-env.js",
    "test:email": "node --test tests/resendEmailApi.test.mjs",
    "test:schema": "node --test tests/supabaseSchema.test.mjs",
    "test:e2ee": "node --test tests/e2ee.test.mjs",
    "supabase:sync": "npm run env:generate && node scripts/setup-supabase.js",
    "supabase:dry-run": "npm run env:generate && node scripts/setup-supabase.js --dry-run",
    "supabase:verify": "npm run env:generate && node scripts/setup-supabase.js --verify-only",
    "vercel:env:sync": "npm run env:generate && node scripts/sync-vercel-env.js",
    "vercel:env:dry": "npm run env:generate && node scripts/sync-vercel-env.js --dry-run",
    "turn:credentials": "node scripts/fetch-turn-credentials.js",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "test:perf": "node --test tests/syncPerformance.test.mjs",
    "perf:audit": "node scripts/perf-audit.mjs",
    "perf:audit:throttle": "node scripts/perf-audit.mjs --throttle",
    "repro:chat": "node scripts/chat-input-repro.mjs",
    "repro:chat:matrix": "node scripts/chat-input-repro.mjs --matrix",
    "ux:audit": "node scripts/ux-audit.mjs",
    "ux:audit:matrix": "node scripts/ux-audit.mjs --matrix",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "prebuild": "npm run env:generate && npm run env:validate",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "npm run build && wrangler dev",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "build-and-sync": "npm run build && npx cap sync",
    "db:setup": "node scripts/setup-supabase.js",
    "db:setup:dry": "node scripts/setup-supabase.js --dry-run",
    "db:verify": "node scripts/setup-supabase.js --verify-only",
    "deploy": "npm run build && wrangler deploy",
    "admin:bootstrap": "node scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/push-notifications": "6.0.5",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^4.1.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.3",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.3",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.84.1",
    "@vladmandic/face-api": "^1.7.15",
    "appwrite": "28.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "emoji-mart": "^5.6.0",
    "firebase-admin": "14.5.0",
    "framer-motion": "^11.16.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.0",
    "resend": "^6.33.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@cloudflare/vite-plugin": "^1.54.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "drizzle-kit": "0.x",
    "drizzle-orm": "0.x",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.32",
    "postgres": "^3.4.9",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.4",
    "wrangler": "^4.131.2"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
