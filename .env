# Base environment configuration (committed to git → placeholders only, never
# real secrets). Load order at runtime: this file first, then `.env.local`
# (gitignored) overrides it for local development, and Vercel's environment
# variables override everything in production.
#
# Replace the "your-project-ref" placeholder with your Supabase project
# reference (Dashboard -> Project Settings -> General -> Reference ID) and the
# key placeholders with the project's anon (publishable) key.

# Supabase project identity (non-secret).
SUPABASE_PROJECT_ID="your-project-ref"

# Server-side Supabase endpoint and anon (publishable) key. Non-secret, but
# must reference the same project as the VITE_ pair below so the client and the
# /api functions never split across projects.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"

# Browser-safe values. Must reference the same project as SUPABASE_URL so the
# client and the /api functions never split across projects.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Auth provider: keep on supabase (Resend OTP) until every Appwrite surface is migrated.
VITE_AUTH_PROVIDER=supabase

# Server-only: used by /api/auth/email-code to send the 6-digit OTP through Resend.
# This file is committed to git, so never put real secrets here.
# Set the live values in the gitignored `.env.local` instead.
SUPABASE_SERVICE_ROLE_KEY=""
RESEND_API_KEY=""
RESEND_FROM="Nexus Chat <admin@nexus-chat-world.com>"
RESEND_EMAIL_DOMAIN="nexus-chat-world.com"

# Server-only: signs the HttpOnly admin session cookie that middleware.js
# requires for every /admin* request. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the live value in the gitignored `.env.local` (and in Vercel).
ADMIN_SESSION_SECRET=""

# Voice calls (browser-safe). Signalling runs over Supabase Realtime and media is
# peer-to-peer. With no TURN relay configured, calls fall back to public STUN and
# can fail behind strict/symmetric NATs — set these in Vercel (and `.env.local`)
# to route media through a relay. Comma-separate multiple URLs.
VITE_STUN_URL=""
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
