# Auth provider: keep on supabase (Resend OTP) until every Appwrite surface is migrated.
VITE_AUTH_PROVIDER=supabase

# Server-only: used by /api/auth/email-code to send the 6-digit OTP through Resend.
# This file is committed to git, so never put real secrets here.
# Set the live values in the gitignored `.env.local` instead.
SUPABASE_SERVICE_ROLE_KEY=""
RESEND_API_KEY=""
RESEND_FROM="Nexus Chat <admin@nexus-chat-world.com>"
RESEND_EMAIL_DOMAIN="nexus-chat-world.com"

# Server-only: signs the HttpOnly admin session cookie that middleware.js
# requires for every /admin* request. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the live value in the gitignored `.env.local` (and in Vercel).
ADMIN_SESSION_SECRET=""

# Voice calls (browser-safe). Signalling runs over Supabase Realtime and media is
# peer-to-peer. With no TURN relay configured, calls fall back to public STUN and
# can fail behind strict/symmetric NATs — set these in Vercel (and `.env.local`)
# to route media through a relay. Comma-separate multiple URLs.
VITE_STUN_URL=""
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""