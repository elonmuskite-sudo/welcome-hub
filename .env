VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndvYXZobGtneWxhcm5ncXl2cGhmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE3OTQyNjcsImV4cCI6MjEwNzM3MDI2N30.em3lBUSPwiR5NYeptYXhDhFC1reyznGocfMqFoD1c-I"
