# Production project: vitmhynebbaiahayylid (us-east-1) — the project Vercel
# production builds and .env.local use, and the one the live app talks to.
# (supabase/.temp links the Supabase CLI to a different project; builds do not
# use that link.)
SUPABASE_PROJECT_ID="vitmhynebbaiahayylid"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_GA5NptBlqx2ELOHYt5XtyQ__QlirlYx"
SUPABASE_ANON_KEY="sb_publishable_GA5NptBlqx2ELOHYt5XtyQ__QlirlYx"
SUPABASE_URL="https://vitmhynebbaiahayylid.supabase.co"

# Browser-safe values. Must reference the same project as SUPABASE_URL so the
# client and the /api functions never split across projects.
VITE_SUPABASE_PROJECT_ID="vitmhynebbaiahayylid"
VITE_SUPABASE_URL="https://vitmhynebbaiahayylid.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_GA5NptBlqx2ELOHYt5XtyQ__QlirlYx"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_GA5NptBlqx2ELOHYt5XtyQ__QlirlYx"

# Auth provider: keep on supabase (Resend OTP) until every Appwrite surface is migrated.
VITE_AUTH_PROVIDER=supabase

# Server-only: used by /api/auth/email-code to send the 6-digit OTP through Resend.
# This file is committed to git, so never put real secrets here.
# Set the live values in the gitignored `.env.local` instead.
SUPABASE_SERVICE_ROLE_KEY=""
RESEND_API_KEY=""
RESEND_FROM="Nexus Chat <admin@nexus-chat-world.com>"
RESEND_EMAIL_DOMAIN="nexus-chat-world.com"

# Server-only: signs the HttpOnly admin session cookie that middleware.js
# requires for every /admin* request. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the live value in the gitignored `.env.local` (and in Vercel).
ADMIN_SESSION_SECRET=""

# Voice calls (browser-safe). Signalling runs over Supabase Realtime and media is
# peer-to-peer. With no TURN relay configured, calls fall back to public STUN and
# can fail behind strict/symmetric NATs — set these in Vercel (and `.env.local`)
# to route media through a relay. Comma-separate multiple URLs.
VITE_STUN_URL=""
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""