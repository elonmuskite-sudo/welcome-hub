# Supabase (browser-safe: project URL and anon/publishable key)
VITE_SUPABASE_URL=https://woavhlkgylarngqyvphf.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Keep on supabase until all browser data/storage/admin paths are migrated.
VITE_AUTH_PROVIDER=supabase
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only: never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Idswyft KYC (server-only; use HTTPS in production).
# IDSWYFT_API_URL is the provider origin.
IDSWYFT_API_URL=https://api.idswyft.app
IDSWYFT_API_KEY=
# Used only to verify Idswyft webhook signatures; keep server-side.
IDSWYFT_WEBHOOK_SECRET=
# 32-byte random key as 64 hex characters or base64url. Keep stable to decrypt
# existing session tokens; do not expose with a VITE_ prefix.
IDSWYFT_SESSION_ENCRYPTION_KEY=
# Optional API path overrides; {id} is replaced with the verification UUID.
IDSWYFT_INIT_PATH=/api/v2/verify/sessions
IDSWYFT_STATUS_PATH=/api/v2/verify/{id}
#APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
# Use Supabase's transaction pooler connection string with sslmode=require.
# Keep this server-side secret; do not use the local migration SUPABASE_DB_URL.
SUPABASE_POOLER_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Only for the local migration CLI; never upload to Vercel.
SUPABASE_DB_URL=postgresql://postgres:your-password@host:5432/postgres

# Email codes via Resend (server-only)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Nexus Chat <admin@nexus-chat-world.com>

# Server-only Twilio transactional SMS delivery.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid

# Admin route protection (server-only): signs the HttpOnly admin session cookie
# that middleware.js requires for /admin*. Use a random 32-byte hex value.
ADMIN_SESSION_SECRET=your_random_hex_secret

# Voice calls (browser-safe). Signalling runs over Supabase Realtime; media is
# peer-to-peer. STUN alone reaches most networks; add a TURN relay so calls also
# connect behind strict/symmetric NATs. Comma-separate multiple URLs.
# Leaving VITE_STUN_URL empty uses the public Google STUN servers.
VITE_STUN_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# Metered Open Relay credential bootstrap (local only; never send this API key
# to Vercel or a browser). Put the values in .env.local, then run
# `npm run turn:credentials -- --write` to write the four VITE_* relay settings.
METERED_APP_NAME=
METERED_API_KEY=

# Web background call alerts (public VAPID key is built into the client).
VITE_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@nexus-chat-world.com

# Native FCM call alerts (server-only JSON service account; never use VITE_).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin bootstrap (local only: npm run admin:bootstrap)
ADMIN_EMAIL=admin@nexus-chat-world.com
ADMIN_PASSWORD=ChangeMeStrongPassword123!
ADMIN_MEMBER_ID=1000000000

# Object storage (Cloudflare R2 / S3-compatible). Server-only: never use a VITE_
# prefix for the credentials. Attachments are uploaded via presigned PUT URLs and
# read back through /api/storage/url, so the bucket itself stays private.
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Browser-safe public base URL for feed media (custom domain or r2.dev URL).
# Leave blank: public access is disabled on the bucket, so every object is read
# through short-lived signed links. Setting this requires re-enabling public
# access, which would also expose private chat attachments.
VITE_R2_PUBLIC_BASE_URL=
