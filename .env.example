# Supabase (browser-safe: project URL and anon/publishable key)
VITE_SUPABASE_URL=https://woavhlkgylarngqyvphf.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Keep on supabase until all browser data/storage/admin/payment paths are migrated.
VITE_AUTH_PROVIDER=supabase
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only: never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Appwrite identity verification (server-side API bridge)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
# Use Supabase's transaction pooler connection string with sslmode=require.
# Keep this server-side secret; do not use the local migration SUPABASE_DB_URL.
SUPABASE_POOLER_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Only for the local migration CLI; never upload to Vercel.
SUPABASE_DB_URL=postgresql://postgres:your-password@host:5432/postgres

# Email codes via Resend (server-only)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Nexus Chat <admin@nexus-chat-world.com>

# Admin route protection (server-only): signs the HttpOnly admin session cookie
# that middleware.js requires for /admin*. Use a random 32-byte hex value.
ADMIN_SESSION_SECRET=your_random_hex_secret

# Voice calls (browser-safe). Signalling runs over Supabase Realtime; media is
# peer-to-peer. STUN alone reaches most networks; add a TURN relay so calls also
# connect behind strict/symmetric NATs. Comma-separate multiple URLs.
# Leaving VITE_STUN_URL empty uses the public Google STUN servers.
VITE_STUN_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# Metered Open Relay users: put METERED_API_KEY + METERED_APP_NAME in .env.local
# (never prefixed with VITE_) and run `npm run turn:credentials -- --write`.

# Admin bootstrap (local only: npm run admin:bootstrap)
ADMIN_EMAIL=admin@nexus-chat-world.com
ADMIN_PASSWORD=ChangeMeStrongPassword123!
ADMIN_MEMBER_ID=1000000000

# NOWPayments: set these as Supabase Edge Function secrets, not in Vercel
# NOWPAYMENTS_API_KEY=your_nowpayments_api_key
# NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
