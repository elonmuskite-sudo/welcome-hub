{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/kyc/init", "destination": "/api/kyc?action=init" },
    { "source": "/api/kyc/upload", "destination": "/api/kyc?action=upload" },
    { "source": "/api/kyc/status", "destination": "/api/kyc?action=status" },
    { "source": "/api/calls/notify", "destination": "/api/calls?action=notify" },
    { "source": "/api/calls/push-subscription", "destination": "/api/calls?action=push-subscription" },
    { "source": "/api/storage/:action",
      "destination": "/api/storage"
    },
    { "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
