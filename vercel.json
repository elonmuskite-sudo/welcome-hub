{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {      "source": "/api/storage/:action",
      "destination": "/api/storage"
    },
    {      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
